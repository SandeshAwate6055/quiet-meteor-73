{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Story script",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "scenes"],
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 100},
    "scenes": {
      "type": "array", "minItems": 1, "maxItems": 30,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "narration", "duration", "visual_description"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$"},
          "narration": {"type": "string", "minLength": 1, "maxLength": 1000},
          "duration": {"type": "number", "exclusiveMinimum": 0, "maximum": 120},
          "visual_description": {"type": "string", "minLength": 1, "maxLength": 500},
          "characters": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$"}}
        }
      }
    }
  }
}
